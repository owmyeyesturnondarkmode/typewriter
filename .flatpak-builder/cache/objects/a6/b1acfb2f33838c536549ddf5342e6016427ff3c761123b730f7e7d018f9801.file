{
  "id" : "com.typewriter.Typewriter",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "51",
  "runtime-commit" : "aed50acfdad2e6c6c05e1595ddbde3c9e642f967bde41bfa70e3a8d962408541",
  "sdk" : "org.gnome.Sdk",
  "sdk-commit" : "8787593c4d75cbdd277a91945eab9185e18de537479eb8401f852d3f746c49c1",
  "command" : "typewriter",
  "modules" : [
    {
      "name" : "typewriter",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : ".",
          "type" : "dir"
        }
      ],
      "build-commands" : [
        "install -D -m 0755 main.py /app/bin/typewriter",
        "install -D -m 0644 com.typewriter.Typewriter.desktop /app/share/applications/com.typewriter.Typewriter.desktop",
        "install -D -m 0644 deb-package/usr/share/icons/hicolor/128x128/apps/typewriter.png /app/share/icons/hicolor/128x128/apps/com.typewriter.Typewriter.png"
      ]
    }
  ],
  "finish-args" : [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc",
    "--talk-name=org.freedesktop.portal.*"
  ]
}